# Copy to .env and adjust. Never commit a real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO
# SQLite for local development; PostgreSQL is the production target:
#   DATABASE_URL=postgresql+psycopg://fraud_ai:CHANGE_ME@localhost:5432/fraud_ai
DATABASE_URL=sqlite:///data/fraud_ai.db
DATA_DIRECTORY=data
MODEL_DIRECTORY=models
EVALUATION_DIRECTORY=evaluation
# Keyed hash (HMAC) secret used to pseudonymise IPs, device identifiers, addresses.
# Required outside development/test. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# PSEUDONYMISATION_KEY=
# Store raw IP addresses alongside their keyed hash (default: false).
STORE_RAW_IP=false
# Stage 7 - local, offline analyst assistant (explanations only; never decisions).
# Runtime: ollama | llamacpp-server | llamacpp-process | reference (template, not an LLM)
# LOCAL_LLM_RUNTIME=ollama
# LOCAL_LLM_MODEL=
# Endpoint must be localhost/loopback/private. Defaults: ollama http://localhost:11434,
# llamacpp-server http://127.0.0.1:8080
# LOCAL_LLM_ENDPOINT=
# LOCAL_LLM_TIMEOUT=120
# llamacpp-process only:
# LOCAL_LLM_BINARY=llama-cli
# LOCAL_LLM_MODEL_PATH=
# Deterministic defaults:
# LOCAL_LLM_TEMPERATURE=0
# LOCAL_LLM_TOP_P=1
# LOCAL_LLM_SEED=0
# LOCAL_LLM_CONTEXT_WINDOW=8192
# LOCAL_LLM_MAX_TOKENS=1200
# Stage 9 - machine-to-machine fraud service (see API.md, SERVICE_SECURITY.md, DEPLOYMENT.md)
# Plain HTTP: localhost only. In production terminate TLS at a reverse proxy.
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8080
# Only these proxy IPs/CIDRs may set X-Forwarded-For (empty = never trusted):
# TRUSTED_PROXIES=
# REQUEST_SIZE_LIMIT=65536
# RATE_LIMIT=120/minute
# RATE_LIMIT_BURST=30
# SERVICE_REQUEST_TIMEOUT=10
# Request signing (HMAC-SHA256); at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SERVICE_SIGNING_MASTER_KEY=
# SERVICE_REQUIRE_SIGNATURES=false
# SIGNATURE_MAX_AGE=300
# CORS is disabled unless origins are listed:
# SERVICE_CORS_ORIGINS=
# SERVICE_EXPOSE_OPENAPI=false
# SERVICE_HSTS=false
# WebAuthn relying party (https origin required outside development/test):
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=fraud-ai (development)
# WEBAUTHN_ORIGIN=http://localhost:8080
# WEBAUTHN_CHALLENGE_TTL=120
# STEP_UP_MAX_ATTEMPTS=3
# Payment authentication: "fake" is a DEVELOPMENT FAKE (not 3-D Secure); refused in
# staging/production. The webhook secret is at least 32 characters.
# PAYMENT_AUTH_PROVIDER=
# PAYMENT_AUTH_WEBHOOK_SECRET=
# PAYMENT_AUTH_TIMEOUT=5
