# Copy to .env and adjust. Never commit a real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO
# SQLite for local development; PostgreSQL is the production target:
#   DATABASE_URL=postgresql+psycopg://fraud_ai:CHANGE_ME@localhost:5432/fraud_ai
DATABASE_URL=sqlite:///data/fraud_ai.db
DATA_DIRECTORY=data
MODEL_DIRECTORY=models
EVALUATION_DIRECTORY=evaluation
# Keyed hash (HMAC) secret used to pseudonymise IPs, device identifiers, addresses.
# Required outside development/test. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# PSEUDONYMISATION_KEY=
# Store raw IP addresses alongside their keyed hash (default: false).
STORE_RAW_IP=false
# Future (Stage 7) - must point at a local/loopback inference runtime:
# LOCAL_LLM_MODEL=
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
