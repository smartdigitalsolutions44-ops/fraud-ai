# Copy to .env and adjust. Never commit a real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO
# SQLite for local development; PostgreSQL is the production target:
#   DATABASE_URL=postgresql+psycopg://fraud_ai:CHANGE_ME@localhost:5432/fraud_ai
DATABASE_URL=sqlite:///data/fraud_ai.db
DATA_DIRECTORY=data
MODEL_DIRECTORY=models
EVALUATION_DIRECTORY=evaluation
# Keyed hash (HMAC) secret used to pseudonymise IPs, device identifiers, addresses.
# Required outside development/test. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# PSEUDONYMISATION_KEY=
# Store raw IP addresses alongside their keyed hash (default: false).
STORE_RAW_IP=false
# Stage 7 - local, offline analyst assistant (explanations only; never decisions).
# Runtime: ollama | llamacpp-server | llamacpp-process | reference (template, not an LLM)
# LOCAL_LLM_RUNTIME=ollama
# LOCAL_LLM_MODEL=
# Endpoint must be localhost/loopback/private. Defaults: ollama http://localhost:11434,
# llamacpp-server http://127.0.0.1:8080
# LOCAL_LLM_ENDPOINT=
# LOCAL_LLM_TIMEOUT=120
# llamacpp-process only:
# LOCAL_LLM_BINARY=llama-cli
# LOCAL_LLM_MODEL_PATH=
# Deterministic defaults:
# LOCAL_LLM_TEMPERATURE=0
# LOCAL_LLM_TOP_P=1
# LOCAL_LLM_SEED=0
# LOCAL_LLM_CONTEXT_WINDOW=8192
# LOCAL_LLM_MAX_TOKENS=1200
# Stage 9 - machine-to-machine fraud service (see API.md, SERVICE_SECURITY.md, DEPLOYMENT.md)
# Plain HTTP: localhost only. In production terminate TLS at a reverse proxy.
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8080
# Only these proxy IPs/CIDRs may set X-Forwarded-For (empty = never trusted):
# TRUSTED_PROXIES=
# REQUEST_SIZE_LIMIT=65536
# RATE_LIMIT=120/minute
# RATE_LIMIT_BURST=30
# SERVICE_REQUEST_TIMEOUT=10
# Request signing (HMAC-SHA256); at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SERVICE_SIGNING_MASTER_KEY=
# SERVICE_REQUIRE_SIGNATURES=false
# SIGNATURE_MAX_AGE=300
# CORS is disabled unless origins are listed:
# SERVICE_CORS_ORIGINS=
# SERVICE_EXPOSE_OPENAPI=false
# SERVICE_HSTS=false
# WebAuthn relying party (https origin required outside development/test):
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=fraud-ai (development)
# WEBAUTHN_ORIGIN=http://localhost:8080
# WEBAUTHN_CHALLENGE_TTL=120
# STEP_UP_MAX_ATTEMPTS=3
# Payment authentication: "fake" is a DEVELOPMENT FAKE (not 3-D Secure); refused in
# staging/production. The webhook secret is at least 32 characters.
# PAYMENT_AUTH_PROVIDER=
# PAYMENT_AUTH_WEBHOOK_SECRET=
# PAYMENT_AUTH_TIMEOUT=5
# Stage 10 - deployment hardening (see HARDENING.md, DEPLOYMENT.md, SERVICE_SECURITY.md)
# Any secret can instead come from a file: NAME_FILE=/run/secrets/name (never both).
# Secrets: PSEUDONYMISATION_KEY, SERVICE_SIGNING_MASTER_KEY, SERVICE_SIGNING_PREVIOUS_KEY,
# PAYMENT_AUTH_WEBHOOK_SECRET, STRIPE_API_KEY, REDIS_URL, DATABASE_URL.
# Shared state for several workers/instances (rate limits, replay claims):
# STATE_BACKEND=memory            # memory (one process) | redis (required for >1 worker in staging/production)
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# REDIS_KEY_PREFIX=fraud-ai:
# REDIS_TIMEOUT=0.5
# Signing-key rotation: the previous master key stays valid until its expiry.
# SERVICE_SIGNING_KEY_VERSION=1
# SERVICE_SIGNING_PREVIOUS_KEY=
# SERVICE_SIGNING_PREVIOUS_KEY_VERSION=
# SERVICE_SIGNING_PREVIOUS_KEY_EXPIRES_AT=   # ISO 8601, e.g. 2026-10-01T00:00:00Z
# SERVICE_KEY_ROTATION_GRACE_HOURS=24         # old API key stays valid this long after rotate
# READINESS_REVERIFY_SECONDS=300              # re-verify the primary model artefact
# Staging may explicitly allow the DEVELOPMENT FAKE payment provider (production never):
# PAYMENT_AUTH_ALLOW_FAKE_IN_STAGING=false
# Stripe TEST-MODE adapter (sk_test_/rk_test_ keys only; never exercised against Stripe here):
# PAYMENT_AUTH_PROVIDER=stripe
# STRIPE_API_KEY=
# STRIPE_RETURN_URL=
# Policy activation needs shadow -> evaluation -> candidate promotion (default: on in production):
# POLICY_REQUIRE_PROMOTION=
# ALLOW_REFERENCE_LLM=false                   # production refuses the template "LLM" otherwise
# LOG_FORMAT=                                 # text | json (json by default in staging/production)
# PostgreSQL pool per worker process (see HARDENING.md for the measurements):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# Retention (fraud-ai retention plan/run/status; dry run by default; 0 disables a category):
# RETENTION_ALLOW_DELETE=false
# RETENTION_IDEMPOTENCY_DAYS=7
# RETENTION_CHALLENGE_DAYS=7
# RETENTION_PAYMENT_REQUEST_DAYS=0
# RETENTION_FAILED_ATTEMPT_DAYS=0
# RETENTION_RAW_IP_DAYS=30
