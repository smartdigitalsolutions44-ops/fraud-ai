# SENTINEL local settings (Stage 14). setup-local copies this to sentinel.local.env once and
# never overwrites your copy. No secrets belong here: Dev-mode secrets are generated into
# .runtime/secrets/ and the demo world keeps its own in data/demo/.

# Ports (all bound to 127.0.0.1). Change one if another program already uses it.
SENTINEL_API_PORT=8080
SENTINEL_CONSOLE_PORT=3000
# Dev mode only (Docker): host ports for PostgreSQL and Redis. Deliberately not 5432/6379,
# so a locally installed PostgreSQL or Redis never collides.
SENTINEL_PG_PORT=55432
SENTINEL_REDIS_PORT=56379

# Open the console in your default browser once it is ready (true/false).
SENTINEL_OPEN_BROWSER=true

# Where the synthetic demo world lives (relative to the repository, or absolute).
SENTINEL_DEMO_ROOT=data/demo

# Optional local LLM for analyst assistance (never used for scoring or decisions).
# Without these, the reference template is used and labelled as such.
# LOCAL_LLM_RUNTIME=ollama
# LOCAL_LLM_MODEL=llama3.2:3b
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
